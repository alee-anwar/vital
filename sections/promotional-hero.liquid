                      <path d="M13.9987 8.55957C12.7296 8.55957 11.489 8.9359 10.4338 9.64097C9.37857 10.346 8.55613 11.3482 8.07047 12.5207C7.58481 13.6932 7.45774 14.9833 7.70533 16.228C7.95292 17.4728 8.56404 18.6161 9.46143 19.5135C10.3588 20.4109 11.5021 21.022 12.7469 21.2696C13.9916 21.5172 15.2817 21.3901 16.4542 20.9044C17.6267 20.4188 18.6289 19.5963 19.3339 18.5411C20.039 17.4859 20.4153 16.2453 20.4153 14.9762C20.4134 13.275 19.7367 11.644 18.5338 10.4411C17.3309 9.23815 15.6999 8.5615 13.9987 8.55957ZM13.9987 20.2262C12.9603 20.2262 11.9453 19.9183 11.0819 19.3414C10.2186 18.7646 9.54568 17.9446 9.14832 16.9853C8.75096 16.026 8.64699 14.9704 8.84956 13.952C9.05213 12.9336 9.55215 11.9981 10.2864 11.2639C11.0206 10.5297 11.9561 10.0297 12.9745 9.8271C13.9929 9.62452 15.0485 9.72849 16.0078 10.1259C16.9671 10.5232 17.787 11.1961 18.3639 12.0595C18.9408 12.9228 19.2487 13.9379 19.2487 14.9762C19.2471 16.3681 18.6934 17.7025 17.7092 18.6867C16.725 19.671 15.3906 20.2246 13.9987 20.2262Z" fill="#3B499E" />
                    </svg>
                  </div>
                  <span>{{ block.settings.guarantee_text }}</span>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>

        <!-- Right Image with Testimonial -->
        <div class="promotional-hero__image">
          {% if section.settings.image != blank %}
            {%- assign widths = '400, 600, 800, 1000, 1200' -%}
            {%- capture sizes -%}
              (min-width: 990px) 50vw, 100vw
            {%- endcapture -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority }}
          {% else %}
            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}

          <!-- Testimonial Overlay -->
          {% if section.settings.show_testimonial %}
            <div class="testimonial-overlay">
              <div class="testimonial-stars">
                {% for i in (1..5) %}
                  <div class="star">
                    {{ 'icon-star.svg' | inline_asset_content }}
                  </div>
                {% endfor %}
              </div>
              <div class="testimonial-count h0">{{ section.settings.customer_count }}</div>
              <h5 class="testimonial-text h6">{{ section.settings.testimonial_text }}</h5>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Promotional Hero",
    "class": "section promotional-hero",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Customer Images"
      },
      {
        "type": "checkbox",
        "id": "show_testimonial",
        "label": "Show Testimonial Overlay",
        "default": true
      },
      {
        "type": "text",
        "id": "customer_count",
        "label": "Customer Count",
        "default": "10+"
      },
      {
        "type": "text",
        "id": "testimonial_text",
        "label": "Testimonial Text",
        "default": "Happy Customers"
      }, {
        "type": "header",
        "content": "Colors"
      }, {
        "type": "color_scheme",
        "id": "section_color_scheme",
        "label": "Section Color Scheme",
        "default": "scheme-1"
      }, {
        "type": "header",
        "content": "Section Padding"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Top Padding",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Bottom Padding",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "limit": 1,
        "settings": [
          {
            "type": "richtext",
            "id": "heading",
            "label": "Heading",
            "default": "<p>Ready to Take Care of your <strong>Smile</strong>?</p>"
          }, {
            "type": "text",
            "id": "colored_text",
            "label": "Colored Text",
            "default": "Smile",
            "info": "Text to highlight with gradient color"
          }
        ]
      },
      {
        "type": "description",
        "name": "Description",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Description",
            "default": "VitalGum has take responsibility of thousands of customers smiles"
          }
        ]
      },
      {
        "type": "features",
        "name": "Features Grid",
        "limit": 1,
        "settings": [
          {
            "type": "image_picker",
            "id": "icon_1",
            "label": "Feature 1 Icon"
          },
          {
            "type": "text",
            "id": "text_1",
            "label": "Feature 1 Text",
            "default": "Combat Plaque Effectively"
          },
          {
            "type": "image_picker",
            "id": "icon_2",
            "label": "Feature 2 Icon"
          },
          {
            "type": "text",
            "id": "text_2",
            "label": "Feature 2 Text",
            "default": "Achieve Lasting Fresh Breath"
          }, {
            "type": "image_picker",
            "id": "icon_3",
            "label": "Feature 3 Icon"
          }, {
            "type": "text",
            "id": "text_3",
            "label": "Feature 3 Text",
            "default": "Brighten Smile Naturally"
          }, {
            "type": "image_picker",
            "id": "icon_4",
            "label": "Feature 4 Icon"
          }, {
            "type": "text",
            "id": "text_4",
            "label": "Feature 4 Text",
            "default": "Enhance Gum Health"
          }, {
            "type": "image_picker",
            "id": "icon_5",
            "label": "Feature 5 Icon"
          }, {
            "type": "text",
            "id": "text_5",
            "label": "Feature 5 Text",
            "default": "Fortify & Protect Teeth"
          }, {
            "type": "image_picker",
            "id": "icon_6",
            "label": "Feature 6 Icon"
          }, {
            "type": "text",
            "id": "text_6",
            "label": "Feature 6 Text",
            "default": "Boost Confidence"
          }
        ]
      },
      {
        "type": "button",
        "name": "t:sections.rich-text.blocks.buttons.name",
        "limit": 2,
        "settings": [
          {
            "type": "header",
            "content": "t:sections.rich-text.blocks.buttons.settings.header_button1.content"
          },
          {
            "type": "text",
            "id": "button_label",
            "default": "t:sections.rich-text.blocks.buttons.settings.button_label_1.default",
            "label": "t:sections.rich-text.blocks.buttons.settings.button_label_1.label",
            "info": "t:sections.rich-text.blocks.buttons.settings.button_label_1.info"
          },
          {
            "type": "url",
            "id": "button_link",
