{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .promotional-hero {
    background: white;
    min-height: 600px;
  }

  .promotional-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    min-height: 600px;
  }

  @media screen and (min-width: 990px) {
    .promotional-hero__content {
      max-width: 460px;
    }
  }

  @media screen and (max-width: 990px) {
    .promotional-hero__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .promotional-hero__grid {
      /* Reverse the order: image above, content below */
      display: flex;
      flex-direction: column;
    }
    .promotional-hero__content {
      order: 2;
    }
    .promotional-hero__image {
      order: 1;
    }
  }

  @media screen and (max-width: 990px) {
    .promotional-hero__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .promotional-hero__content {
    padding: 2rem 0;
  }

  .promotional-hero__heading {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    color: #1a1a1a;
  }

  .promotional-hero__heading .highlight {
    color: var(--theme-color);
  }

  .promotional-hero__description {
    font-size: 1.4rem;
    color: #666;
    margin-bottom: 3rem;
    line-height: 1.5;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  @media screen and (max-width: 750px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  .feature-item {
    text-align: center;
    padding: 1rem;
  }

  .feature-icon {
    width: 60px;
    height: 60px;
    margin: 0 auto 1rem;
    border: 2px solid #667eea;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
  }

  .feature-icon img {
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  .feature-text {
    font-size: 1.2rem;
    font-weight: 500;
    color: #1a1a1a;
    line-height: 1.3;
  }

  .buttons-container {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .guarantee-section {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.2rem;
    margin-top: 2rem;
  }

  .promotional-hero__image {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
  }

  .promotional-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: white;
    padding: 2rem;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    min-width: 200px;
  }

  .testimonial-stars {
    display: flex;
    justify-content: center;
    gap: 0.3rem;
    margin-bottom: 1rem;
  }

  .testimonial-count {
    background: linear-gradient(90deg, rgba(1, 125, 187, 1), rgba(59, 73, 158, 1) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .promotional-hero .button--primary {
    margin-right: 2rem;
  }

  @media screen and (max-width: 750px) {
    .promotional-hero__heading {
      font-size: 2.5rem;
    }

    .promotional-hero__description {
      font-size: 1.2rem;
    }

    .buttons-container {
      flex-direction: column;
    }

    .btn-primary,
    .btn-secondary {
      text-align: center;
    }

    .promotional-hero__image {

      width: 100%;

    }

    .promotional-hero__content {
      padding: 0;
    }

    .promotional-hero__heading p {
      margin: 0;
    }

    .promotional-hero .button--primary {
      margin-right: 1rem;
    }
  }
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width">
    <div class="promotional-hero">
      <div class="promotional-hero__grid">
        <!-- Left Content -->
        <div class="promotional-hero__content">
          {%- for block in section.blocks -%}
            {% case block.type %}
              {%- when 'heading' -%}
                <h1 class="promotional-hero__heading" {{ block.shopify_attributes }}>
                  {% if block.settings.colored_text != blank %}
                    {% assign split_heading = block.settings.heading | split: block.settings.colored_text %}
                    {{ split_heading | first }}
                    <span class="highlight">{{ block.settings.colored_text }}</span>
                    {{- split_heading | last -}}
                  {% else %}
                    {{ block.settings.heading }}
                  {% endif %}
                </h1>

              {%- when 'description' -%}
                <p class="promotional-hero__description" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </p>

              {%- when 'features' -%}
                <div class="features-grid" {{ block.shopify_attributes }}>
                  {% for i in (1..6) %}
                    {% assign icon_key = 'icon_' | append: i %}
                    {% assign icon = block.settings[icon_key] %}
                    {% assign text_key = 'text_' | append: i %}
                    {% assign text = block.settings[text_key] %}

                    {% if text != blank %}
                      <div class="feature-item">
                        <div class="feature-icon">
                          {% if icon != blank %}
                            <img
                              src="{{ icon | image_url: width: 30 }}"
                              alt=""
                              width="30"
                              height="30"
                              loading="lazy">
                          {% endif %}
                        </div>
                        <div class="feature-text">{{ text }}</div>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>

              {%- when 'button' -%}
                <div
                  class="rich-text__buttons{% if block.settings.button_label != blank and block.settings.button_label_2 != blank %} rich-text__buttons--multiple{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                  {% endif %}>
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                      role="link"
                      aria-disabled="true"
                      {% else %}
                      href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}{% if block.settings.gradient_button %} button--gradient{% endif %}">
                      {{- block.settings.button_label | escape -}}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.button_label_2 != blank -%}
                    <a
                      {% if block.settings.button_link_2 == blank %}
                      role="link"
                      aria-disabled="true"
                      {% else %}
                      href="{{ block.settings.button_link_2 }}"
                      {% endif %}
                      class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}{% if block.settings.gradient_button_2 %} button--gradient{% endif %}">
                      {{- block.settings.button_label_2 | escape -}}
                    </a>
                  {%- endif -%}
                </div>

              {%- when 'guarantee' -%}
                <div class="guarantee-section" {{ block.shopify_attributes }}>
                  <div class="guarantee-icon">
                    <svg
                      width="28"
                      height="29"
                      viewBox="0 0 28 29"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg">
