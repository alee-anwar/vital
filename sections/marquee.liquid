        "min": 10,
        "max": 60,
        "step": 5,
        "unit": "s",
        "default": 20,
        "info": "Duration for one complete scroll cycle"
      }, {
        "type": "header",
        "content": "Spacing"
      }, {
        "type": "range",
        "id": "padding_block_start",
        "label": "Top Padding",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 24
