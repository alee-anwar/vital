{{ 'section-transformation.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="transformation-section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="transformation-container page-width">
    <div class="transformation-content">
      {%- comment -%} Main Title {%- endcomment -%}
      <div class="transformation-header">
        <h2 class="transformation-heading {{ section.settings.heading_size }} transformation-heading--{{ section.settings.heading_max_width }}">
          {{ section.settings.heading_prefix }}
          <span class="transformation-highlight">{{ section.settings.heading_highlight }}</span>
          {{ section.settings.heading_suffix }}
        </h2>
        {%- if section.settings.description != blank -%}
          <p class="transformation-description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} Transformation Phases {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <div class="transformation-phases">
          {%- comment -%} Desktop Timeline View {%- endcomment -%}
          <div class="transformation-timeline desktop-only">
            <div class="timeline-line"></div>
            {%- for block in section.blocks -%}
              {%- if block.type == 'phase' -%}
                <div class="timeline-phase" {{ block.shopify_attributes }}>
                  <div class="phase-number">{{ forloop.index }}</div>
                  <div class="phase-content">
                    <div class="phase-icon">
                      {%- if block.settings.icon_image != blank -%}
                        {{ block.settings.icon_image | image_url: width: 80 | image_tag: class: 'phase-icon-image' }}
                      {%- elsif block.settings.icon != blank -%}
                        {{ block.settings.icon }}
                      {%- else -%}
                        <svg
                          width="40"
                          height="40"
                          viewBox="0 0 40 40"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg">
                          <path
                            d="M20 2L22.5 12.5H33L24.5 19L27 29.5L20 23L13 29.5L15.5 19L7 12.5H17.5L20 2Z"
                            stroke="currentColor"
                            stroke-width="2"
                            fill="none" />
                        </svg>
                      {%- endif -%}
                    </div>
                    <div class="phase-duration">{{ block.settings.duration }}</div>
                    <div class="phase-title">{{ block.settings.title }}</div>
                    {%- if block.settings.description != blank -%}
                      <div class="phase-description">{{ block.settings.description }}</div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- comment -%} Mobile Slider View {%- endcomment -%}
          <div class="transformation-slider mobile-only">
            <slider-component class="slider">
              <ul
                id="Slider-{{ section.id }}"
                class="transformation-slider-list"
                role="list">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'phase' -%}
                    <li
                      id="Slide-{{ section.id }}-{{ forloop.index }}"
                      class="transformation-slide"
                      {{ block.shopify_attributes }}>
                      <div class="slide-phase-number">{{ forloop.index }}</div>
                      <div class="slide-phase-content">
                        <div class="slide-phase-icon">
                          {%- if block.settings.icon_image != blank -%}
                            {{ block.settings.icon_image | image_url: width: 80 | image_tag: class: 'slide-phase-icon-image' }}
                          {%- elsif block.settings.icon != blank -%}
                            {{ block.settings.icon }}
                          {%- else -%}
                            <svg
                              width="40"
                              height="40"
                              viewBox="0 0 40 40"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg">
                              <path
                                d="M20 2L22.5 12.5H33L24.5 19L27 29.5L20 23L13 29.5L15.5 19L7 12.5H17.5L20 2Z"
                                stroke="currentColor"
                                stroke-width="2"
                                fill="none" />
                            </svg>
                          {%- endif -%}
                        </div>
                        <div class="slide-phase-duration">{{ block.settings.duration }}</div>
                        <div class="slide-phase-title">{{ block.settings.title }}</div>
                        {%- if block.settings.description != blank -%}
                          <div class="slide-phase-description">{{ block.settings.description }}</div>
                        {%- endif -%}
                      </div>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

              {%- comment -%} Slider Navigation {%- endcomment -%}
              <div class="slider-buttons">
                <button
                  type="button"
                  class="slider-button slider-button--prev"
                  name="previous"
                  aria-label="{{ 'general.slider.previous_slide' | t }}">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 20 20"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg">
                    <path
                      d="M12.5 15L7.5 10L12.5 5"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                  </svg>
                </button>
                <button
                  type="button"
                  class="slider-button slider-button--next"
                  name="next"
                  aria-label="{{ 'general.slider.next_slide' | t }}">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 20 20"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg">
                    <path
                      d="M7.5 5L12.5 10L7.5 15"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                  </svg>
                </button>
              </div>

              {%- comment -%} Slider Dots {%- endcomment -%}
              <div class="slider-dots">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'phase' -%}
                    <button
                      type="button"
                      class="slider-dot{% if forloop.first %} slider-dot--active{% endif %}"
                      data-slide="{{ forloop.index }}"
                      aria-label="Go to slide {{ forloop.index }}"></button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </slider-component>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
    // Use more specific selectors to avoid conflicts with other sections
    const slider = document.querySelector('#Slider-{{ section.id }}');
    const dots = document.querySelectorAll('#Slider-{{ section.id }}').length > 0 ? 
                 document.querySelectorAll('#Slider-{{ section.id }}').item(0).parentElement.querySelectorAll('.slider-dot') : 
                 [];
    const prevButton = document.querySelector('#Slider-{{ section.id }}').length > 0 ? 
                       document.querySelector('#Slider-{{ section.id }}').parentElement.querySelector('.slider-button--prev') : 
                       null;
    const nextButton = document.querySelector('#Slider-{{ section.id }}').length > 0 ? 
                       document.querySelector('#Slider-{{ section.id }}').parentElement.querySelector('.slider-button--next') : 
                       null;
  
    if (!slider || !dots.length) return;
  
    let currentSlide = 0;
    const totalSlides = dots.length;
  
    function updateDots() {
        dots.forEach((dot, index) => {
            dot.classList.toggle('slider-dot--active', index === currentSlide);
        });
    }
  
    function goToSlide(slideIndex) {
        currentSlide = slideIndex;
        const slideWidth = slider.clientWidth;
        slider.scrollTo({
            left: slideIndex * slideWidth,
            behavior: 'smooth'
        });
        updateDots();
    }
  
    // Dot click handlers - use more specific event delegation
    dots.forEach((dot, index) => {
        dot.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            goToSlide(index);
        });
    });
  
    // Button click handlers
    if (prevButton) {
        prevButton.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            currentSlide = currentSlide > 0 ? currentSlide - 1 : totalSlides - 1;
            goToSlide(currentSlide);
        });
    }
  
    if (nextButton) {
        nextButton.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            currentSlide = currentSlide < totalSlides - 1 ? currentSlide + 1 : 0;
            goToSlide(currentSlide);
        });
    }
  
    // Update dots on scroll
    slider.addEventListener('scroll', function() {
        const slideWidth = slider.clientWidth;
        const newSlide = Math.round(slider.scrollLeft / slideWidth);
        if (newSlide !== currentSlide) {
            currentSlide = newSlide;
            updateDots();
        }
    });
  });
</script>

{% schema %}
  {
    "name": "Transformation Phases",
    "tag": "section",
    "class": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "header",
        "content": "Section Settings"
      },
      {
        "type": "text",
        "id": "heading_prefix",
        "label": "Heading Prefix",
        "default": "Your"
      },
      {
        "type": "text",
        "id": "heading_highlight",
        "label": "Heading Highlight",
        "default": "12-Month"
      },
      {
        "type": "text",
        "id": "heading_suffix",
        "label": "Heading Suffix",
        "default": "Dental Transformation"
      }, {
        "type": "select",
        "id": "heading_size",
        "options": [
          {
            "value": "h5",
            "label": "t:sections.all.heading_size.options__1.label"
          },
          {
            "value": "h4",
            "label": "t:sections.all.heading_size.options__2.label"
          },
          {
            "value": "h3",
            "label": "t:sections.all.heading_size.options__3.label"
          },
          {
            "value": "h2",
            "label": "t:sections.all.heading_size.options__4.label"
          }, {
            "value": "h1",
            "label": "t:sections.all.heading_size.options__5.label"
          }
        ],
        "default": "h1",
        "label": "t:sections.all.heading_size.label"
      }, {
        "type": "select",
        "id": "heading_max_width",
        "options": [
          {
            "value": "small",
            "label": "Small"
          }, {
            "value": "medium",
            "label": "Medium"
          }, {
            "value": "large",
            "label": "Large"
          }, {
            "value": "full",
            "label": "Full width"
          }
        ],
        "default": "large",
        "label": "Heading max width"
      }, {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "info": "Optional description text below the heading"
      }, {
        "type": "header",
        "content": "Section Colors"
      }, {
        "type": "select",
        "id": "color_scheme",
        "options": [
          {
            "value": "accent-1",
            "label": "Accent 1"
          },
          {
            "value": "accent-2",
            "label": "Accent 2"
          },
          {
            "value": "background-1",
            "label": "Background 1"
          },
          {
            "value": "background-2",
            "label": "Background 2"
          }, {
            "value": "inverse",
            "label": "Inverse"
          }
        ],
        "default": "background-1",
        "label": "Color Scheme"
      }, {
        "type": "header",
        "content": "Section Padding"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Top Padding",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Bottom Padding",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "phase",
        "name": "Transformation Phase",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Phase Title",
            "default": "Phase Title"
          },
          {
            "type": "text",
            "id": "duration",
            "label": "Duration",
            "default": "Months 1-3",
            "info": "e.g., Months 1-3, Weeks 1-2, etc."
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Phase Description",
            "info": "Optional description for this phase"
          },
          {
            "type": "image_picker",
            "id": "icon_image",
            "label": "Icon Image",
            "info": "Upload an image for the phase icon. Recommended size: 80x80px or larger."
          }, {
            "type": "html",
            "id": "icon",
            "label": "Custom SVG Icon",
            "info": "Add custom SVG icon HTML. If both image and SVG are provided, the image will be used."
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Transformation Phases",
        "blocks": [
          {
            "type": "phase",
            "settings": {
              "title": "The Foundation",
              "duration": "Months 1-3",
              "description": "Building the groundwork for your dental transformation journey."
            }
          }, {
            "type": "phase",
            "settings": {
              "title": "Repair Phase",
              "duration": "Months 3-6",
              "description": "Active restoration and improvement of your dental health."
            }
          }, {
            "type": "phase",
            "settings": {
              "title": "Polishing Effect",
              "duration": "Months 6-9",
              "description": "Refinement and enhancement of your dental appearance."
            }
          }, {
            "type": "phase",
            "settings": {
              "title": "Long-Term Benefit",
              "duration": "Months 9-12",
              "description": "Maintaining and protecting your transformed dental health."
            }
          }
        ]
      }
    ]
  }
{% endschema %}