{{ 'section-flavours.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="flavours-section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="flavours-container page-width">
    <div class="flavours-content">
      {%- comment -%} Dynamic Heading and Description {%- endcomment -%}
      <div class="flavours-header">
        <h2 class="flavours-heading {{ section.settings.heading_size }}">
          {{ section.settings.heading_prefix }}
          <span class="flavour-name" data-flavour-name>
            {%- if section.blocks.size > 0 -%}
              {{ section.blocks.first.settings.flavour_name }}
            {%- endif -%}
          </span>
        </h2>
        <p class="flavours-description" data-flavour-description>
          {%- if section.blocks.size > 0 -%}
            {{ section.blocks.first.settings.header_description }}
          {%- endif -%}
        </p>
      </div>

      {%- comment -%} Flavour Cards {%- endcomment -%}
      <div class="flavours-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'flavour_card' -%}
            <button
              class="flavour-card{% if forloop.first %} flavour-card--active{% endif %}"
              data-flavour-card
              data-flavour-name="{{ block.settings.flavour_name }}"
              data-flavour-description="{{ block.settings.header_description }}"
              data-card-description="{{ block.settings.card_description }}"
              {% if block.settings.product_url != blank %}
              data-product-url="{{ block.settings.product_url }}"
              {% endif %}
              {{ block.shopify_attributes }}
              type="button">

              <div class="flavour-card__icon-container">
                {%- if block.settings.flavour_icon != blank -%}
                  <div class="flavour-card__icon">
                    <img
                      src="{{ block.settings.flavour_icon | image_url: width: 80 }}"
                      alt="{{ block.settings.flavour_name }}"
                      loading="lazy"
                      width="46"
                      height="46">
                  </div>
                {%- endif -%}

                <h5 class="flavour-card__heading h5">{{ block.settings.flavour_name }}</h5>
                <p class="flavour-card__text">{{ block.settings.card_description }}</p>

              </div>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  class FlavoursSection {
    constructor(container) {
      this.container = container;
      this.flavourNameEl = container.querySelector('[data-flavour-name]');
      this.flavourDescriptionEl = container.querySelector('[data-flavour-description]');
      this.cards = container.querySelectorAll('[data-flavour-card]');
      
      this.init();
    }
  
    init() {
      this.cards.forEach(card => {
        card.addEventListener('click', (e) => this.handleCardClick(e));
      });
    }
  
    handleCardClick(e) {
      const card = e.currentTarget;
      const flavourName = card.dataset.flavourName;
      const flavourDescription = card.dataset.flavourDescription;
      
      // Update active state
      this.cards.forEach(c => c.classList.remove('flavour-card--active'));
      card.classList.add('flavour-card--active');
      
      // Update header content with animation
      this.updateContent(flavourName, flavourDescription);
    }
  
    updateContent(name, description) {
      // Fade out
      this.flavourNameEl.style.opacity = '0';
      this.flavourDescriptionEl.style.opacity = '0';
      
      setTimeout(() => {
        // Update content
        this.flavourNameEl.textContent = name;
        this.flavourDescriptionEl.textContent = description;
        
        // Fade in
        this.flavourNameEl.style.opacity = '1';
        this.flavourDescriptionEl.style.opacity = '1';
      }, 200);
    }
  }
  
  // Initialize all flavour sections on the page
  document.addEventListener('DOMContentLoaded', () => {
    const flavourSections = document.querySelectorAll('.flavours-section');
    flavourSections.forEach(section => new FlavoursSection(section));
  });
  
  // Support for Shopify theme editor
  if (Shopify.designMode) {
    document.addEventListener('shopify:section:load', (event) => {
      const section = event.target.querySelector('.flavours-section');
      if (section) {
        new FlavoursSection(section);
      }
    });
  }
</script>

{% schema %}
  {
    "name": "Flavours",
    "tag": "section",
    "class": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-1"
      },
      {
        "type": "text",
        "id": "heading_prefix",
        "label": "Heading Prefix",
        "default": "Shop by Flavors:",
        "info": "Text before the dynamic flavour name"
      },
      {
        "type": "select",
        "id": "heading_size",
        "options": [
          {
            "value": "h5",
            "label": "t:sections.all.heading_size.options__1.label"
          },
          {
            "value": "h4",
            "label": "t:sections.all.heading_size.options__2.label"
          },
          {
            "value": "h3",
            "label": "t:sections.all.heading_size.options__3.label"
          },
          {
            "value": "h2",
            "label": "t:sections.all.heading_size.options__4.label"
          }, {
            "value": "h1",
            "label": "t:sections.all.heading_size.options__5.label"
          }
        ],
        "default": "h1",
        "label": "t:sections.all.heading_size.label"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 60
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 60
      }
    ],
    "blocks": [
      {
        "type": "flavour_card",
        "name": "Flavour Card",
        "settings": [
          {
            "type": "image_picker",
            "id": "flavour_icon",
            "label": "Flavour Icon"
          },
          {
            "type": "text",
            "id": "flavour_name",
            "label": "Flavour Name",
            "default": "Mint"
          },
          {
            "type": "textarea",
            "id": "header_description",
            "label": "Header Description",
            "default": "Discover the taste that fuels your smile choose your favorite VitalGum flavor.",
            "info": "This appears in the header when this flavour is selected"
          },
          {
            "type": "textarea",
            "id": "card_description",
            "label": "Card Description",
            "default": "Cool, crisp, and refreshing—perfect for all-day freshness.",
            "info": "This appears on the card itself"
          }, {
            "type": "url",
            "id": "product_url",
            "label": "Product URL (Optional)",
            "info": "Link to product page when card is clicked"
          }
        ]
      }
    ],
    "max_blocks": 6,
    "presets": [
      {
        "name": "Flavours",
        "blocks": [
          {
            "type": "flavour_card",
            "settings": {
              "flavour_name": "Mint",
              "header_description": "Discover the taste that fuels your smile choose your favorite VitalGum flavor.",
              "card_description": "Cool, crisp, and refreshing—perfect for all-day freshness."
            }
          }, {
            "type": "flavour_card",
            "settings": {
              "flavour_name": "Raspberry",
              "header_description": "Experience the burst of fruity freshness with our Raspberry flavor.",
              "card_description": "Sweet, tangy, and bursting with fruity energy."
            }
          }, {
            "type": "flavour_card",
            "settings": {
              "flavour_name": "Cinnamon",
              "header_description": "Embrace the warmth and spice of our bold Cinnamon flavor.",
              "card_description": "Warm, bold, and spicy with every chew."
            }
          }
        ]
      }
    ]
  }
{% endschema %}