{{ 'section-clean-choices.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="clean-choices-section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="clean-choices-container page-width">
    <div class="clean-choices-content">
      {%- comment -%} Main Title {%- endcomment -%}
      <div class="clean-choices-header">
        <h2 class="clean-choices-heading {{ section.settings.heading_size }}">
          {{ section.settings.heading_prefix }}
          <span class="clean-choices-highlight">{{ section.settings.heading_highlight }}</span>
        </h2>
        {%- if section.settings.description != blank -%}
          <p class="clean-choices-description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} Feature Blocks {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <div class="clean-choices-features">
          {%- comment -%} Desktop Grid View {%- endcomment -%}
          <div class="clean-choices-grid desktop-only">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <div class="feature-block" {{ block.shopify_attributes }}>
                  <div class="feature-icon">
                    {%- if block.settings.icon_image != blank -%}
                      {{ block.settings.icon_image | image_url: width: 80 | image_tag: class: 'feature-icon-image' }}
                    {%- elsif block.settings.icon != blank -%}
                      {{ block.settings.icon }}
                    {%- else -%}
                      <svg
                        width="60"
                        height="60"
                        viewBox="0 0 60 60"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg">
                        <circle
                          cx="30"
                          cy="30"
                          r="28"
                          stroke="currentColor"
                          stroke-width="2" />
                        <path
                          d="M20 30L25 35L40 20"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round" />
                      </svg>
                    {%- endif -%}
                  </div>
                  <h6 class="feature-label h6">{{ block.settings.title }}</h6>
                </div>
              {%- endif -%}
            {%- endfor -%}
        </div>

          {%- comment -%} Mobile View - Grid for 3 or fewer blocks, Slider for more {%- endcomment -%}
          {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
          {%- if feature_blocks.size <= 3 -%}
            <div class="clean-choices-mobile-grid mobile-only">
              {%- for block in feature_blocks -%}
                <div class="feature-block" {{ block.shopify_attributes }}>
                  <div class="feature-icon">
                    {%- if block.settings.icon_image != blank -%}
                      {{ block.settings.icon_image | image_url: width: 80 | image_tag: class: 'feature-icon-image' }}
                    {%- elsif block.settings.icon != blank -%}
                      {{ block.settings.icon }}
                    {%- else -%}
                      <svg
                        width="60"
                        height="60"
                        viewBox="0 0 60 60"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg">
                        <circle
                          cx="30"
                          cy="30"
                          r="28"
                          stroke="currentColor"
                          stroke-width="2" />
                        <path
                          d="M20 30L25 35L40 20"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round" />
                      </svg>
                    {%- endif -%}
                  </div>
                  <div class="feature-label">{{ block.settings.title }}</div>
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="clean-choices-slider mobile-only">
              <slider-component class="slider">
                <ul
                  id="CleanChoicesSlider-{{ section.id }}"
                  class="clean-choices-slider-list"
                  role="list">
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'feature' -%}
                      <li
                        id="Slide-{{ section.id }}-{{ forloop.index }}"
                        class="clean-choices-slide"
                        {{ block.shopify_attributes }}>
                        <div class="slide-feature-icon">
                          {%- if block.settings.icon_image != blank -%}
                            {{ block.settings.icon_image | image_url: width: 80 | image_tag: class: 'slide-feature-icon-image' }}
                          {%- elsif block.settings.icon != blank -%}
                            {{ block.settings.icon }}
                          {%- else -%}
                            <svg
                              width="60"
                              height="60"
                              viewBox="0 0 60 60"
                              fill="none"
                              xmlns="http://www.w3.org/2000/svg">
                              <circle
                                cx="30"
                                cy="30"
                                r="28"
                                stroke="currentColor"
                                stroke-width="2" />
                              <path
                                d="M20 30L25 35L40 20"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round" />
                            </svg>
                          {%- endif -%}
                        </div>
                        <div class="slide-feature-label">{{ block.settings.title }}</div>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
              </ul>

                {%- comment -%} Slider Dots {%- endcomment -%}
                {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
                {%- assign total_slides = feature_blocks.size | divided_by: 3.0 | ceil -%}
                <div class="slider-dots">
                  {%- for i in (1..total_slides) -%}
                    <button
                      type="button"
                      class="slider-dot{% if forloop.first %} slider-dot--active{% endif %}"
                      data-slide="{{ forloop.index0 }}"
                      aria-label="Go to slide {{ forloop.index }}"></button>
                  {%- endfor -%}
                </div>
              </slider-component>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Use more specific selectors to avoid conflicts with other sections
    const slider = document.querySelector('#CleanChoicesSlider-{{ section.id }}');
    const dots = document.querySelectorAll('#CleanChoicesSlider-{{ section.id }}').length > 0 ? 
                 document.querySelectorAll('#CleanChoicesSlider-{{ section.id }}').item(0).parentElement.querySelectorAll('.slider-dot') : 
                 [];
  
    // Only initialize slider if it exists (more than 3 blocks)
    if (!slider || !dots.length) return;
  
    let currentSlide = 0;
    const totalSlides = dots.length;
    const itemsPerSlide = 3;
  
    function updateDots() {
        dots.forEach((dot, index) => {
            dot.classList.toggle('slider-dot--active', index === currentSlide);
        });
    }
  
    function goToSlide(slideIndex) {
        currentSlide = slideIndex;
        const slideWidth = slider.clientWidth;
        slider.scrollTo({
            left: slideIndex * slideWidth,
            behavior: 'smooth'
        });
        updateDots();
    }
  
    // Dot click handlers - use more specific event delegation
    dots.forEach((dot, index) => {
        dot.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            goToSlide(index);
        });
    });
  
    // Update dots on scroll
    slider.addEventListener('scroll', function() {
        const slideWidth = slider.clientWidth;
        const newSlide = Math.round(slider.scrollLeft / slideWidth);
        if (newSlide !== currentSlide) {
            currentSlide = newSlide;
            updateDots();
        }
    });
  });
</script>

